-- q1. Find all customers whose names start with 'A'. 
select 
	c.CustomerName
from 
	sales.Customers c
where
	c.CustomerName like 'A%';

-- q2. List all products that have a stock quantity greater than 100. 
select 
	*
from 
	Warehouse.StockItemHoldings shi
where
	shi.QuantityOnHand > 100;

-- q3. Retrieve the top 5 most expensive products. 
select
	top 5
	si. StockItemName,
	si.UnitPrice
from
	Warehouse.StockItems si
order by
	si.UnitPrice desc;

-- q4. Show all orders placed in the last 7 days from the max invoice date. 
-- Needs to be greater than 7 days before the max invoice date
select 
	*
from
	sales.Invoices inv
where
	inv.InvoiceDate >
	dateadd
		(day, -7,
			(select max(invoicedate) from sales.Invoices)
		);
