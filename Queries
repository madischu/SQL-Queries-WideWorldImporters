-- q5. Find all suppliers located in the United States. 
select
	s.SupplierName
from 
	Purchasing.Suppliers s
	join Application.Cities cy
		on s.DeliveryCityID = cy.CityID
	join Application.StateProvinces sp
		on cy.StateProvinceID = sp.StateProvinceID
	join Application.Countries ct
		on sp.CountryID = ct.CountryID
where 
	ct.CountryName = 'United States';

-- q6. Retrieve the total sales amount per customer. 
select
	sc.CustomerName,
	sum(il.quantity + il.unitprice) as total_sales
from 
	sales.Customers sc
	join sales.Invoices inv
		on sc.CustomerID = inv.BillToCustomerID
	join sales.InvoiceLines il
		on inv.InvoiceID = il.InvoiceID
group by
	sc.CustomerName;

-- q7. List all employees who work in the 'Sales' department. 
select
	p.FullName
from 
	Application.People p
where 
	p.IsSalesperson = 1;

-- q8. Show the number of orders placed per customer. 
select
	c.CustomerID,
	c.CustomerName,
	count(o.OrderID) as OrdersPlaced
from 
	Sales.Customers c
	join Sales.Orders o
		on c.CustomerID = o.CustomerID
group by
	c.CustomerID,
	c.CustomerName
order by 
	OrdersPlaced desc;

-- q9. Retrieve the names of all products that have not been ordered. 
select
	si.StockItemName,
	sit.InvoiceID,
	sit.PurchaseOrderID
from 
	Warehouse.StockItems si
	join Warehouse.StockItemTransactions sit
		on si.StockItemID = sit.StockItemID
where 
	sit.PurchaseOrderID is NULL
	AND sit.InvoiceID is NULL;

-- q10. List the total amount of purchases for each supplier. 
select
	ps.SupplierName,
	count(pt.purchaseorderid) as total_purchases
from 
	Purchasing.Suppliers ps
	join Purchasing.SupplierTransactions pt
		on ps.SupplierID = pt.SupplierID
where 
	pt.TransactionAmount > 0
group by 
	ps.SupplierName;

-- q11. Retrieve the monthly sales totals for 2018. 
select 
	datepart(month, inv.InvoiceDate),
	sum(il.quantity + il.unitprice) as total_sales
from
	Sales.Invoices inv
	join sales.InvoiceLines il
		on inv.InvoiceID = il.InvoiceID
where
	inv.InvoiceDate >= '2018-01-01'
	AND InvoiceDate < '2019-01-01'
group by
	datepart(month, inv.InvoiceDate)
order by
	1;

-- q12. Retrieve all orders along with the customer name for each order. 
select
	cus.CustomerName,
	count(ord.orderid) as order_count
from 
	Sales.Orders ord
	join Sales.Customers cus
		on ord.customerid = cus.customerid
group by
	cus.CustomerName
order by
	1;

-- q13. List all products and their supplier names. 
select 
	si.StockItemName,
	su.SupplierName
from 
	Warehouse.StockItems si
	join Purchasing.Suppliers su
		on si.SupplierID = su.SupplierID
order by
	1;

-- q14. Show all orders and include the invoices if they exist. 
select 
	o.OrderID,
	o.OrderDate,
	i.InvoiceID,
	i.InvoiceDate
from 
	Sales.Orders o
	left join Sales.Invoices i
		on o.OrderID = i.OrderID;

-- q15. Find all invoices and include corresponding orders if available. 
select 
	i.InvoiceID,
	i.InvoiceDate,
	o.OrderID,
	o.OrderDate
from 
	Sales.Invoices i
	left join Sales.Orders o
		on o.OrderID = i.OrderID;

-- q16. Retrieve a complete list of all customers and any orders they have placed. 
select
	cus.CustomerName,
	count(ord.orderid) as order_count
from 
	Sales.Customers cus
	join Sales.Orders ord
		on ord.customerid = cus.customerid
group by
	cus.CustomerName
order by
	2;

-- q17. List all employees and the department they belong to. 
select
	p.FullName as employee_name,
	case
		when p.IsSalesperson = 1 
			then 'Sales'
		when p.PersonID in (select 
								          distinct 
								          pickedbypersonid 
							          from 
								          Sales.Orders
							          ) 
			then 'Warehouse'
		else 'Administration'
	end as department_name
from 
	Application.People p
where 
	p.IsEmployee = 1
order by
	1;

-- q18. Show all stock items along with the category names they belong to. 
select 
	sg.StockGroupName,
	si.StockItemName
from 
	Warehouse.StockGroups sg
	join Warehouse.StockItemStockGroups sig
		on sg.StockGroupID = sig.StockGroupID
	join Warehouse.StockItems si
		on sig.StockItemID = si.StockItemID
order by
	1,2;

-- q19. Find all suppliers along with the products they supply (including suppliers who supply no products). 
select 
	s.SupplierName,
	si.StockItemName
from 
	Purchasing.Suppliers s
	left join Warehouse.StockItems si
		on s.SupplierID = si.SupplierID
order by
	1,2;

-- q20. Retrieve all customers and the orders they have placed in April 2025. 
select 
	c.CustomerName,
	o.OrderID,
	o.OrderDate
from 
	Sales.Customers c
	join  Sales.Orders o
		on c.CustomerID = o.CustomerID
where 
	o.OrderDate >= '2019-01-01'
	and o.OrderDate < '2019-02-01'
order by
	1,3;
